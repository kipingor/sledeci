{
    "name": "sledeci/kenya-payments",
    "description": "Mobile-money collections for the Sledeci suite: M-Pesa (STK push, C2B), Airtel Money and MTN MoMo, with webhook handling.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sledeci/core": "^0.1",
        "sledeci/accounting": "^0.1"
    },
    "suggest": {
        "sledeci/pos": "Take M-Pesa payments at the till."
    },
    "autoload": {
        "psr-4": {
            "Sledeci\\KenyaPayments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sledeci\\KenyaPayments\\KenyaPaymentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Antony Kipingor",
            "email": "kipingor@gmail.com"
        }
    ],
    "homepage": "https://github.com/kipingor/sledeci-kenya-payments",
    "support": {
        "issues": "https://github.com/kipingor/sledeci-kenya-payments/issues",
        "source": "https://github.com/kipingor/sledeci-kenya-payments"
    }
}
