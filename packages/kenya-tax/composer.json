{
    "name": "sledeci/kenya-tax",
    "description": "KRA eTIMS integration for the Sledeci suite: submit invoices, fetch standard codes, test the connection.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sledeci/core": "^0.1",
        "sledeci/accounting": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Sledeci\\KenyaTax\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sledeci\\KenyaTax\\KenyaTaxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Antony Kipingor",
            "email": "kipingor@gmail.com"
        }
    ],
    "homepage": "https://github.com/kipingor/sledeci-kenya-tax",
    "support": {
        "issues": "https://github.com/kipingor/sledeci-kenya-tax/issues",
        "source": "https://github.com/kipingor/sledeci-kenya-tax"
    }
}
