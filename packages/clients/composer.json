{
    "name": "sledeci/clients",
    "description": "Client management for the Sledeci suite: client profiles, follow-ups and client reports (shows invoices and balances from the accounting package).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sledeci/core": "^0.1",
        "inertiajs/inertia-laravel": "^3.0",
        "sledeci/accounting": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Sledeci\\Clients\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sledeci\\Clients\\ClientsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Antony Kipingor",
            "email": "kipingor@gmail.com"
        }
    ],
    "homepage": "https://github.com/kipingor/sledeci-clients",
    "support": {
        "issues": "https://github.com/kipingor/sledeci-clients/issues",
        "source": "https://github.com/kipingor/sledeci-clients"
    }
}
